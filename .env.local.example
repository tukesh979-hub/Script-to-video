# Copy this file to .env.local and fill in real values. .env.local is
# gitignored -- never commit real keys.
#
# Get these from your Supabase project: Project Settings -> API, and
# Project Settings -> Database -> Connection string.

# --- Public: safe to ship in the client bundle -----------------------------
# These two are DESIGNED to be public (Supabase's anon key is meaningless
# without RLS -- it can only do what a table's RLS policies allow an
# anonymous/authenticated request to do). Nothing else in this file should
# ever be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only: NEVER prefix with NEXT_PUBLIC_, never returned to the client ---
# service_role bypasses RLS entirely -- only used server-side, only for the
# specific admin operations that need it (e.g. crediting a new signup before
# a profile row exists to run an RLS-scoped insert against). Every other
# server-side query uses the user's own session via createServerClient, which
# respects RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Postgres connection string for Drizzle (schema/migrations only -- runtime
# queries go through the Supabase client, not this). Use the POOLED
# connection string (transaction mode, port 6543), not the direct one --
# Vercel's serverless functions need pooling, and drizzle-kit push/generate
# work fine through the pooler too.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Rate limiting (Postgres-backed, no extra service required) ------------
# No separate env var needed -- uses the same DATABASE_URL / Supabase
# connection above. See src/lib/rate-limit.ts for why this project didn't
# reach for Upstash/Redis yet.

# --- App URL, used for auth email redirect links ----------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
